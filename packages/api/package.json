{
  "name": "@arcswarm/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/types-export.d.ts"
    },
    "./types": {
      "import": "./dist/types-export.js",
      "types": "./dist/types-export.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@arcswarm/shared": "workspace:*",
    "@prisma/adapter-pg": "^5.19.0",
    "@prisma/client": "^5.19.0",
    "@sentry/integrations": "^7.114.0",
    "@sentry/node": "^10.69.0",
    "@sentry/profiling-node": "^10.69.0",
    "@sentry/tracing": "^7.120.4",
    "@sentry/opentelemetry": "^10.69.0",
    "@trpc/server": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "pg": "^8.12.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "superjson": "^2.2.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/auto-instrumentations-node": "^0.45.0",
    "@opentelemetry/exporter-prometheus": "^0.55.0",
    "@opentelemetry/resources": "^1.27.0",
    "@opentelemetry/semantic-conventions": "^1.27.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^2.1.9",
    "prisma": "^5.19.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
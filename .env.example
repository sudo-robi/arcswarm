# ArcSwarm Environment Variables
# Copy to .env and fill in ALL values

# ===========================================
# BLOCKCHAIN (Arc Testnet)
# ===========================================
ARC_RPC_URL=https://rpc.testnet.arc.network
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Contract Addresses (Pre-deployed on Arc Testnet)
VAULT_ADDRESS=0x86014c6473574F93d4BFc386541681f8c1200160
BUDGET_MANAGER_ADDRESS=0xC62734d9E83AbA8e1B337667ACBf67F5b6E3375e
AGENT_REGISTRY_ADDRESS=0x8007d0C9630f1AaB8A371702964AD2a5C07d7868
RISK_ORACLE_ADDRESS=0xF36CB7f4c8D7E267FFfEEa33D0757e1A5a94C3cd
PAYMENT_ROUTER_ADDRESS=0x11d0b045Df255940de0dF6CfD0130d9D25204214
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ===========================================
# CIRCLE API (Required for App Kits)
# ===========================================
# Get from: https://console.circle.com/ → API Keys → Create Key (App Kits scope)
CIRCLE_API_KEY=your_circle_api_key_here
# Get from: https://console.circle.com/ → Entity Secret → Generate
CIRCLE_ENTITY_SECRET=your_circle_entity_secret_here

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
# Provision at Railway/Neon/Supabase, then paste connection string
# Add ?connection_limit=10&pool_timeout=20 for connection pooling
DATABASE_URL=postgresql://user:pass@host:5432/arcswarm?connection_limit=10&pool_timeout=20
# Direct URL for migrations (bypasses pooler)
DIRECT_URL=postgresql://user:pass@host:5432/arcswarm

# ===========================================
# API SERVER
# ===========================================
PORT=3001

# ===========================================
# FRONTEND (Vite)
# ===========================================
# Update AFTER Railway deploy
VITE_API_URL=https://api.arcswarm.xyz
VITE_ARC_RPC_URL=https://rpc.testnet.arc.network
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@arcswarm/contracts": ["packages/contracts/src"],
      "@arcswarm/agents": ["packages/agents/src"],
      "@arcswarm/api": ["packages/api/src"],
      "@arcswarm/shared": ["packages/shared/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next"]
}
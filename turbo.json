{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "outputs": [],
      "dependsOn": []
    },
    "db:migrate": {
      "dependsOn": []
    },
    "db:seed": {
      "dependsOn": ["db:migrate"]
    },
    "agent:start": {
      "cache": false,
      "persistent": true
    },
    "agent:test": {
      "dependsOn": ["build"]
    }
  },
  "globalEnv": ["DATABASE_URL", "ARC_RPC_URL", "PRIVATE_KEY", "CIRCLE_API_KEY", "CIRCLE_ENTITY_SECRET"]
}